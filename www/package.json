{
  "name": "uix-ui-www",
  "private": true,
  "type": "module",
  "scripts": {
    "themes": "node scripts/themes.mjs",
    "dev": "npm run themes && vite",
    "build": "npm run themes && node scripts/component-docs.mjs && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "site:copy": "rm -rf ../../uix-website/site/public/ui && cp -R dist ../../uix-website/site/public/ui"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "~5.8.3",
    "vite": "6.3.5"
  }
}
